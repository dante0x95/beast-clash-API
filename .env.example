PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://beast:beast@localhost:5433/beast_clash
LOG_LEVEL=debug
# comma-separated origins allowed to call the API from a browser; empty = none
CORS_ORIGINS=
# max requests per IP per window (all routes except /health)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# reverse proxies in front of the app (1 on most PaaS); 0 locally
TRUST_PROXY=0